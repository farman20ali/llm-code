# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
DB_PROTOCOL=postgresql://
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=irs

# OpenAI API Configuration
